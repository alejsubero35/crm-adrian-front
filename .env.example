# API Configuration
VITE_API_URL=http://api-crm-adrian.test/api
VITE_API_BASE_CENTRAL=http://api-crm-adrian.test/api

# App Configuration
VITE_APP_NAME=CRUD Boilerplate
VITE_APP_VERSION=1.0.0

# Development
VITE_DEV_MODE=true

# Google Maps — OBLIGATORIO para autocompletar dirección (opcional: escribir a mano sin key)
# Obtener clave: .\scripts\configurar-google-maps.ps1
# APIs a habilitar: Maps JavaScript API + Places API
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Future multitenancy configuration
